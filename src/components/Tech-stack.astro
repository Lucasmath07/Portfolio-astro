---
import Tech from "../components/Tech.astro";
---

<section class="tech-stack" id="tech-stack">
  <div class="title">
    <p class="main-title">TECH STACK</p>
    <p class="bar">|</p>
    <p class="sub-title tech-sub">
      The languages and tools I use to bring ideas to life
    </p>
  </div>
  <div class="tools">
    <Tech
      image="html-image.png"
      text="HTML"
    />
    <Tech
      image="css-image.png"
      text="CSS"
    />
    <Tech
      image="js-image.png"
      text="JavaScript"
    />
    <Tech
      image="git-image.png"
      text="GIT"
    />
    <Tech
    image="astro.svg"
    text="Astro"/>
    <Tech
    image="tailwindcss-icon-icon-original.svg"
    text="Tailwind CSS"/>
    <Tech image="cpp.png"
    text="C++"/>
    <Tech image="Java.svg"
    text="Java"/>
    <Tech image="python-original.svg"
    text="Python"/>
    <Tech image="fastapi-original-wordmark.svg"
    text="FastAPI"/>
    <Tech image="react-original.svg"
    text="React"/>
    <Tech image="nextjs-original.svg"
    text="NextJs"/>
  </div>
</section>
